{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "summary", "markdown", "diagram", "visual_html", "change_note"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["supplement", "correction", "replacement", "example"]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "markdown": {"type": "string", "minLength": 1, "maxLength": 8000},
    "diagram": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "caption", "nodes", "edges"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "caption": {"type": "string", "maxLength": 500},
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "detail"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"},
              "label": {"type": "string", "minLength": 1, "maxLength": 80},
              "detail": {"type": "string", "maxLength": 300}
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label"],
            "properties": {
              "from": {"type": "string", "maxLength": 40},
              "to": {"type": "string", "maxLength": 40},
              "label": {"type": "string", "maxLength": 80}
            }
          }
        }
      }
    },
    "visual_html": {"type": ["string", "null"], "maxLength": 40000},
    "change_note": {"type": "string", "minLength": 1, "maxLength": 800}
  }
}
