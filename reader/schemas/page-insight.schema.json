{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "main_point",
    "context",
    "sections",
    "takeaways",
    "caveats",
    "modern_view"
  ],
  "properties": {
    "main_point": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "context": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "kind",
          "source_location",
          "source_quote",
          "source_regions",
          "original_meaning",
          "paragraphs",
          "boundary",
          "evidence",
          "motivation",
          "claim_type"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_regions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "original_meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "boundary": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "figure",
              "mechanism",
              "argument",
              "experiment"
            ]
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2200
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "motivation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "实验观察",
              "条件性证明",
              "方法设计",
              "作者假设",
              "作者主张",
              "背景知识"
            ]
          }
        }
      }
    },
    "takeaways": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "modern_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sources"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url",
              "published"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "published": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      }
    }
  }
}
